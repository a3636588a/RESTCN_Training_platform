#ifndef CNN_POSTPROCESS_H
#define CNN_POSTPROCESS_H

#include <stdint.h>
#include <stdbool.h>
#include "cnn_detect.h"

/* Default parameters based on UI backfill */
#define CNN_POST_ALPHA_DEFAULT     0.40f
#define CNN_POST_MARGIN_DEFAULT    0.45f
#define CNN_POST_EXIT_DEFAULT      0.25f

/* Tiered Validation Settings */
#define CNN_POST_STABLE_FAST       0
#define CNN_POST_STABLE_NORMAL     8
#define CNN_POST_STABLE_RESTRICTED 12

#define CNN_POST_THRESH_FAST       0.70f
#define CNN_POST_THRESH_NORMAL     0.50f
#define CNN_POST_THRESH_RESTRICTED 0.75f

typedef struct {
    float proba_smooth[CNN_OUT_DIM];
    int active_id;
    int last_best_id;
    uint32_t stable_count;
    uint32_t stable_threshold; 
} cnn_post_ctx_t;

void cnn_post_init(cnn_post_ctx_t *ctx);
void cnn_post_reset_buffer(cnn_post_ctx_t *ctx);
int cnn_post_update(cnn_post_ctx_t *ctx, const float *raw_proba);

#endif
